# Serves the built SPA and forwards /api/* to the backend (the same /api
# prefix the Vite dev server proxies). TLS is left to the reverse proxy in
# front of this container; see README "Production".
:80 {
	# Not encoded: encrypted parts do not compress, and the albumEvents
	# stream (text/event-stream) must reach the browser event by event.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:3001 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		root * /srv
		try_files {path} /index.html
		file_server {
			precompressed gzip
		}
	}
}
